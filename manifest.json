{
  "manifest_version": 3,
  "name": "DTU Specialization Helper",
  "version": "0.0.1",
  "permissions": ["storage"],
  "host_permissions": ["https://studieplan.dtu.dk/*"],
  "description": "A helper tool for DTU students to track their specialization progress.",
  "icons": {
    "16": "icons/icon16.png"
  },
  "content_scripts": [
    {
      "matches": ["https://studieplan.dtu.dk/*", "https://kurser.dtu.dk/*"],
      "run_at": "document_idle",
      "css": ["content/styles.css"],
      "js": [
        "content/specializations/cse.js",
        "content/specializations/applied_chemistry.js",
        "content/specializations/architectural_engineering.js",
        "content/specializations/bioinformatics.js",
        "content/specializations/biotechnology.js",
        "content/specializations/business_analytics.js",
        "content/specializations/chbe.js",
        "content/specializations/civil_engineering.js",
        "content/specializations/ctsd.js",
        "content/specializations/design_and_innovation.js",
        "content/specializations/earth_space_physics.js",
        "content/specializations/electrical_engineering.js",
        "content/specializations/engineering_acoustics.js",
        "content/specializations/engineering_light.js",
        "content/specializations/engineering_physics.js",
        "content/specializations/environmental_engineering.js",
        "content/specializations/food_technology.js",
        "content/specializations/human_centered_ai.js",
        "content/specializations/industrial_engineering_management.js",

        "content/content.js"
      ]
    }
  ]
}
